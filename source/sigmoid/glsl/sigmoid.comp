#version 430
#ifndef WIDTH
#define WIDTH 1
#endif
layout(local_size_x = 128) in;
layout(std430, binding = 0) readonly buffer Input { float x[]; };
layout(std430, binding = 1) writeonly buffer Output { float y[]; };
#ifdef VULKAN
layout(push_constant) uniform Parameters { uint n; };
#else
uniform uint n;
#endif
void main() {
    uint base = gl_GlobalInvocationID.x * WIDTH;
    for (uint j = 0; j < WIDTH; ++j) {
        uint i = base + j;
        if (i < n) y[i] = 1.0 / (1.0 + exp(-x[i]));
    }
}
