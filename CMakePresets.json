{
  "version": 3,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default (Tesla T4 / SM75)",
      "description": "Build for Tesla T4 GPU (Compute Capability 7.5) with optimization and debug info",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/default",
      "cacheVariables": {
        "CMAKE_CUDA_ARCHITECTURES": "75",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "native",
      "displayName": "Native (auto-detect GPU)",
      "description": "Auto-detect the local GPU architecture (requires CMake 3.23+)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native",
      "cacheVariables": {
        "CMAKE_CUDA_ARCHITECTURES": "native",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "ampere",
      "displayName": "Ampere (RTX 3080 / SM86)",
      "description": "Build for Ampere architecture (Compute Capability 8.6)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ampere",
      "cacheVariables": {
        "CMAKE_CUDA_ARCHITECTURES": "86",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "release",
      "displayName": "Release (native, optimized)",
      "description": "Optimized release build targeting the local GPU",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_CUDA_ARCHITECTURES": "native",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug (native)",
      "description": "Unoptimized native build for debugging and device-side tools",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_CUDA_ARCHITECTURES": "native",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "hip",
      "displayName": "AMD HIP (native GPU)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/hip",
      "cacheVariables": {
        "USE_HIP": "ON",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "opengl",
      "displayName": "OPENGL GLSL compute",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/opengl",
      "cacheVariables": {
        "USE_OPENGL": "ON",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "vulkan",
      "displayName": "VULKAN GLSL compute",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/vulkan",
      "cacheVariables": {
        "USE_VULKAN": "ON",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "native",
      "configurePreset": "native"
    },
    {
      "name": "ampere",
      "configurePreset": "ampere"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "hip",
      "configurePreset": "hip"
    },
    {
      "name": "opengl",
      "configurePreset": "opengl"
    },
    {
      "name": "vulkan",
      "configurePreset": "vulkan"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "native",
      "configurePreset": "native",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ampere",
      "configurePreset": "ampere",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "hip",
      "configurePreset": "hip",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "opengl",
      "configurePreset": "opengl",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "vulkan",
      "configurePreset": "vulkan",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
